# Copy to .env and fill in.
# --- LLM (generation) ---
# "anthropic" (Claude API) or "ollama" (free, runs locally)
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=your_key_here
# For ollama use something like: llama3.2
LLM_MODEL=llama3.2
# --- Retrieval knobs (tune these, then re-run ingest.py + eval.py) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
# If the best chunk scores below this, the bot says "not found" instead of guessing
MIN_SCORE=0.2
HF_HUB_OFFLINE=1